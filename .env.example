# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=jscm
DB_PASSWORD=jscm
DB_DATABASE=jscm

# Rate limiting
LIMITER_STORE=database

# Social sign-in (all optional). A provider is enabled only when ALL its
# variables are set; otherwise its button is hidden and its routes return 404.

# GitHub OAuth — https://github.com/settings/developers ("OAuth Apps")
# Authorization callback URL: ${APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google — https://console.cloud.google.com/apis/credentials
# OAuth client of type "Web application" (scopes: openid, email, profile)
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple — https://developer.apple.com/account/resources
# APPLE_CLIENT_ID: the Services ID (e.g. cm.javascript.web), with "Sign in with
# Apple" enabled, the site domain registered and the Return URL:
#   ${APP_URL}/auth/apple/callback   (HTTPS and a real domain are required)
# APPLE_TEAM_ID: 10-character Team ID; APPLE_KEY_ID: ID of the key below.
# APPLE_PRIVATE_KEY: contents of the AuthKey_XXXXXXXXXX.p8 file (PEM). Either
# quoted on several lines, or on one line with escaped newlines:
#   APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
