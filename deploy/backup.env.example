# /etc/jscm/backup.env (root:root, chmod 600) — off-site backups with restic.
# Any S3-compatible storage works. Examples:
#   Cloudflare R2:  s3:https://<account-id>.r2.cloudflarestorage.com/jscm-backups
#   Backblaze B2:   s3:https://s3.<region>.backblazeb2.com/jscm-backups
RESTIC_REPOSITORY=
# Encryption password: store it in a password manager too, backups are
# unreadable without it.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
