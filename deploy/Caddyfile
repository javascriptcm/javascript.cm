# /etc/caddy/Caddyfile — managed by javascript.cm deploy

# Shared site configuration. {args[0]} = local port of the environment's app
# container (staging 3333, production 3334, previews 40000+<pr>).
(app) {
	encode zstd gzip

	# Cap request bodies (articles are < 100 KB)…
	@regular_body not {
		method POST
		path /settings/cv
	}
	request_body @regular_body {
		max_size 1MB
	}

	# …except the only upload of the site: the CV (PDF, 5 MB max, checked
	# again by the app, which also caps the multipart body at 6 MB).
	@cv_upload {
		method POST
		path /settings/cv
	}
	request_body @cv_upload {
		max_size 6MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:{args[0]} {
		health_uri /up
		health_interval 30s
	}

	# Access logs go to journald: journalctl -u caddy
	log
}

# Environments that must stay out of search engines.
(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

javascript.cm {
	import app 3334
}

www.javascript.cm {
	redir https://javascript.cm{uri} permanent
}

staging.javascript.cm {
	import app 3333
	import noindex
}

# Temporary: direct access by IP until the staging DNS points here.
# Let's Encrypt issues IP certificates with the short-lived profile
# (about 6 days, renewed automatically by Caddy).
169.58.106.105 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import app 3333
	import noindex
}

# Pull request previews: one site file per PR, written by deploy/preview.sh.
import /etc/caddy/previews/*.caddy
